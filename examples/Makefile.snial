
CC=m68k-apple-macos-gcc
CXX=m68k-apple-macos-g++
#CC=powerpc-apple-macos-gcc
#CXX=powerpc-apple-macos-g++

CFLAGS=-include override.h
CFLAGS+=-I../slowhand -DNO_QD_TRAPS=1

LDFLAGS=-L.. ../crossfb/*.o ../slowhand/*.o -lm


OBJS=$(subst .c,.o,$(wildcard *.c)) $(subst .cpp,.o,$(wildcard *.cpp))


.c.o:
	$(CC) $(CFLAGS) -c -o $@ $<

.cpp.o:
	$(CXX) $(CFLAGS) -c -o $@ $<


all: $(OBJS) SillyBalls MWSillyBalls TubeTest LinesSilly maclines Count Sample TestPerf MPWTest DoubleBuffer SndForEver TestGestaltQD TestGestaltVM


SillyBalls:	SillyBalls.o
	$(CXX) -o SillyBalls.code.bin SillyBalls.o $(LDFLAGS)
	../bin2app.sh SillyBalls
#	$(CXX) -o SillyBalls $(OBJS) $(LDFLAGS)
#	../xcoff2app.sh SillyBalls

